# Use a long, random value in production. The app refuses the development fallback in production.
SESSION_SECRET=replace-with-at-least-32-random-characters
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-this-before-deployment
# HTTPS endpoint that sends the reset URL to the owner. It receives { email, resetUrl }.
PASSWORD_RESET_WEBHOOK_URL=https://mailer.example.internal/password-reset
